# Copy to elk/elk.env (git-ignored) and adapt
# Value: $(docker info --format '{{.DockerRootDir}}')/containers
# Docker snap: /var/snap/docker/common/var-lib-docker/containers
DOCKER_CONTAINERS_DIR=/var/lib/docker/containers
# Value: docker context inspect --format '{{.Endpoints.docker.Host}}' (without unix://)
DOCKER_SOCK=/var/run/docker.sock
